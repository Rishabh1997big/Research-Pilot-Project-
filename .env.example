# Copy this file to .env and fill in your own keys. Never commit .env.

# LLM provider: groq or gemini. If both have a key and a model, the other one is the fallback.
LLM_PROVIDER=groq
GROQ_API_KEY=
# Tested Groq chat models: openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.8-27b
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Search provider: ddgs (no key needed) or tavily
SEARCH_PROVIDER=ddgs
TAVILY_API_KEY=
# Cache search results in data/search_cache (delete the folder to get fresh results)
SEARCH_CACHE=true
# Cache the text of pages that were read in data/page_cache (same reason: v1 and v2 runs read the same text)
PAGE_CACHE=true
# Contact (email or project URL) the page reader sends so sites know who is reading; Wikipedia requires one.
# Leave empty to read as a common browser (Wikipedia pages are then skipped).
READER_CONTACT=

# LangSmith tracing (free key at https://smith.langchain.com)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=researchpilot
# System version tag on every trace (v1, v2...) for comparing versions in LangSmith
RUN_VERSION=v1

# Storage (paths are relative to the project folder)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHROMA_DIR=data/chroma
CHECKPOINT_DB=data/checkpoints.sqlite

# App
API_BASE_URL=http://localhost:8000
